# Copy to .env; never commit it. No credentials are needed for deterministic mode.
# local_ml uses the included learned DataCo model; auto uses an LLM when configured.
TRADEOFF_AI_MODE=local_ml
TRADEOFF_ML_MODEL_PATH=models/delivery-risk.json
TRADEOFF_LLM_MODE=auto
# Options: openai (Responses API), openai-compatible (Chat Completions), disabled.
TRADEOFF_LLM_PROVIDER=openai
TRADEOFF_LLM_BASE_URL=https://api.openai.com/v1
TRADEOFF_LLM_MODEL=
TRADEOFF_LLM_API_KEY=
TRADEOFF_LLM_TIMEOUT=12
TRADEOFF_LLM_MAX_CALLS=6
# Hard overall wall-clock budget; fallback is explicit if exceeded.
TRADEOFF_RUN_TIMEOUT=45
# auto selects OS CBC + PuLP 3.x if installed; otherwise exact bounded enumeration.
TRADEOFF_SOLVER=auto

